# =============================================================
# AQLIYA Staging Environment Configuration
# Copy to .env and fill in the actual secrets before deploying.
# ⚠️  This file is tracked in git. Do NOT put real secrets here.
# =============================================================

# === Required: Database ===
# Staging RDS or dedicated PostgreSQL instance.
# Staging DB should be a distinct database from production.
DATABASE_URL=postgresql://aqliya_staging:<PASSWORD>@<staging-db-host>:5432/aqliya_staging?connection_limit=20&pool_timeout=10

# === Required: Auth ===
AUTH_SECRET=<generate-with-openssl-rand-base64-32>
NEXTAUTH_URL=https://staging.aqliya.com

# === Required: Download URL signing ===
DOWNLOAD_TOKEN_SECRET=<generate-with-openssl-rand-base64-32>

# === Staging Domain ===
NEXT_PUBLIC_APP_URL=https://staging.aqliya.com

# === Staging S3 / Object Storage ===
# Staging evidence bucket — separate from production.
STORAGE_PROVIDER=s3
S3_BUCKET=aqliya-staging-evidence
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=<staging-s3-access-key>
S3_SECRET_ACCESS_KEY=<staging-s3-secret-key>
# S3_ENDPOINT=https://<endpoint>  # Uncomment for S3-compatible storage

# === File Scanning ===
# Staging uploads should be scanned to match production behavior.
SCANNER_PROVIDER=clamav
CLAMAV_HOST=<clamav-host>
CLAMAV_PORT=3310

# === Redis (required for staging rate limiting) ===
# Staging should use Redis-backed rate limiting to approximate production.
REDIS_URL=redis://<staging-redis-host>:6379
# REDIS_PASSWORD=<staging-redis-password>

# === Rate Limiter ===
# Staging deploys may use multiple tasks; use redis for shared counters.
RATE_LIMITER=redis

# === Cache ===
# Staging cache prefix — isolates cache keys from production.
CACHE_PREFIX=aqliya:staging:cache:

# === Storage ===
LOCAL_STORAGE_DIR=/app/uploads

# === Logging ===
# info = operational logs without debug noise.
# Set to debug temporarily during staging debugging.
LOG_LEVEL=info

# === Observability / Tracing ===
ENABLE_TRACING=false
SENTRY_DSN=<staging-sentry-dsn>
SENTRY_AUTH_TOKEN=<staging-sentry-auth-token>
NEXT_PUBLIC_SENTRY_DSN=<staging-sentry-dsn-public>
SENTRY_ORG=aqliya
SENTRY_PROJECT=aqliya-staging

# === AI (staging should use real providers for realistic testing) ===
AI_MODE=cloud
AI_PROVIDER=openai
OPENAI_API_KEY=<staging-openai-key>
ANTHROPIC_API_KEY=<staging-anthropic-key>
ANTHROPIC_MODEL=claude-sonnet-4-20250514
FF_AI_REAL_PROVIDERS=true
FF_AI_RAG=true

# === Analytics ===
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=staging.aqliya.com

# === Feature Flags (staging = mirror production as closely as possible) ===
FF_AUDIT_INTELLIGENCE=true
FF_AUDIT_REPORTING_GRAPH=true
FF_AUDIT_LEAD_SCHEDULE_AUTO=false
FF_AUDIT_RECONCILIATION=false
FF_AUDIT_FS_V2=false
FF_AUDIT_IFRS_RULES=false
FF_AUDIT_SOCPA_RULES=false
FF_ABAC_ENFORCE=false
FF_ABAC_SHADOW=true
FF_EVENT_OUTBOX=true
FF_EVENT_SCHEMA_REGISTRY=true

# === LocalContentOS Staging Config ===
LOCALCONTENT_CONTENT_BACKEND=prisma

# === Notification Engine ===
SMTP_HOST=<staging-smtp-host>
SMTP_PORT=587
SMTP_USER=<staging-smtp-user>
SMTP_PASS=<staging-smtp-password>
SMTP_FROM=noreply@aqliya.ai
SMTP_SECURE=false
NOTIFICATION_RATE_LIMIT_PER_MIN=60

# === Audit Retention ===
AUDIT_RETENTION_DAYS=90
AUDIT_ARCHIVE_DIR=/app/audit-archives

# === Performance ===
ANALYZE=false
