    {
      "ruleId": "ifrs-19-r003",
      "paragraphReference": "IFRS 19.B2",
      "ruleText": "A subsidiary without public accountability is a subsidiary that does not file or is not in the process of filing its financial statements with a securities regulator or similar authority for the purpose of issuing instruments in a public market.",
