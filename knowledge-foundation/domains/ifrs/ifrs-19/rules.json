      "ruleId": "ifrs-19-r001",
      "paragraphReference": "IFRS 19.3",
      "ruleText": "A subsidiary that does not have public accountability may elect to apply the disclosure requirements in IFRS 19 instead of the disclosure requirements in other IFRSs, provided it applies them consistently.",
      "topic": "subsidiary-scope-election",
