      "ruleId": "ifrs-19-r002",
      "paragraphReference": "IFRS 19.6",
      "ruleText": "A subsidiary applying IFRS 19 shall disclose that it is a subsidiary without public accountability and that it has elected to apply the reduced disclosure requirements.",
      "topic": "subsidiary-election-disclosure",
      "usage": "disclosure-engine",
