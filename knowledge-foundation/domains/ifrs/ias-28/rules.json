    {
      "ruleId": "ias-28-r003",
      "paragraphReference": "IAS 28.38",
      "ruleText": "An entity shall discontinue the use of the equity method from the date that the investment ceases to be an associate or a joint venture and account for the investment in accordance with IFRS 9.",
