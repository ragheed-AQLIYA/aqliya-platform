      "ruleId": "ias-26-r002",
      "paragraphReference": "IAS 26.18",
      "ruleText": "A defined benefit plan shall measure its present obligation as the present value of the expected future payments required to settle the obligation, using actuarial valuation methods.",
      "topic": "retirement-plan-obligation-measurement",
      "usage": "mapping-engine",
      "assetType": "A",
