  "rules": [
    {
      "ruleId": "ias-29-r001",
      "paragraphReference": "IAS 29.3",
      "ruleText": "An entity whose functional currency is the currency of a hyperinflationary economy shall restate its financial statements in terms of the measuring unit current at the end of the reporting period.",
      "topic": "hyperinflation-restatement",
      "usage": "mapping-engine",
      "assetType": "A",
      "lineageParentId": "kf-accounting-a-ias-29",
      "confidenceScore": 90,
