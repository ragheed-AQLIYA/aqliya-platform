# === Required ===
# Database URL format: postgresql://user:password@host:port/database
# Connection pool: ?connection_limit=X&pool_timeout=Y
# Production: use a PgBouncer or AWS RDS Proxy connection URL for connection pooling.
#            Set connection_limit=20 for standard workloads.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aqliya?connection_limit=20&pool_timeout=10
# pgvector Docker (avoids local Postgres on 5432): docker compose -f docker-compose.yml -f docker-compose.pgvector.yml up -d db
# DATABASE_URL_PGVECTOR_DOCKER=postgresql://postgres:postgres@localhost:5434/aqliya_pilot

# NextAuth v5 — AUTH_SECRET is required at runtime (auth-config + middleware).
# NEXTAUTH_SECRET is accepted as a legacy alias by validate-env.mjs only.
AUTH_SECRET=change-me-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# === Recommended for controlled deployment ===
# Optional for startup; session-authenticated evidence downloads work without it.
# Required when using signed/token-based evidence download URLs.
DOWNLOAD_TOKEN_SECRET=change-me-use-openssl-rand-base64-32
LOCAL_STORAGE_DIR=./uploads
STORAGE_PROVIDER=local
# === AQLIYA Platform ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Marketing launch (optional) ===
# Cal.com / Calendly link for Schedule Diagnostic CTAs
NEXT_PUBLIC_BOOKING_URL=
# YouTube/Vimeo embed for /demo executive video section
NEXT_PUBLIC_DEMO_VIDEO_URL=

# === Analytics ===
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# === Error Monitoring ===
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# === Distributed Tracing (OpenTelemetry) ===
# OTLP endpoint for trace export (e.g., http://localhost:4318 for local Jaeger/OTLP collector)
# Leave empty to disable OTLP export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aqliya-platform
OTEL_SERVICE_VERSION=0.1.0
# Enable console span export for local development (true/false)
OTEL_CONSOLE_EXPORTER=false
# Sampling ratio: 0.0 (none) to 1.0 (all). Default: 1.0
OTEL_SAMPLING_RATIO=1.0
# Diagnostic log level: none, error, warn, info, debug
OTEL_LOG_LEVEL=warn
# === AI (assistive features only — optional) ===
# cloud | local | hybrid — hybrid routes mapping tasks to local Ollama when FF_AI_REAL_PROVIDERS=true
AI_MODE=cloud
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_CLOUD_API_KEY=
AI_CLOUD_BASE_URL=
AI_CLOUD_MODEL=
AI_CLOUD_PROVIDER_NAME=
AI_LOCAL_BASE_URL=http://localhost:11434
# e.g. llama3, qwen3:8b (must match `ollama list` tag)
AI_LOCAL_MODEL=llama3
AI_LOCAL_EMBED_MODEL=nomic-embed-text
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=default
EMBEDDING_PROVIDER=mock
FF_AI_REAL_PROVIDERS=false
FF_AI_RAG=false
FF_AUDIT_INTELLIGENCE=false
FF_AUDIT_REPORTING_GRAPH=false
FF_AUDIT_LEAD_SCHEDULE_AUTO=false
FF_AUDIT_RECONCILIATION=false
FF_AUDIT_RECONCILIATION_GATES=false
FF_AUDIT_FS_V2=false
FF_AUDIT_IFRS_RULES=false
FF_AUDIT_SOCPA_RULES=false
FF_AUDIT_DISCLOSURE_AUTO=false
FF_AUDIT_APPROVAL_GATES=false
FF_AUDIT_MIND_MAP=false

# === File scanning (production uploads require SCANNER_PROVIDER) ===
# Supported: clamav
#
# 🚨 PRODUCTION / PILOT EVIDENCE UPLOADS: Set SCANNER_PROVIDER=clamav and run a
#    reachable ClamAV daemon. Empty SCANNER_PROVIDER is OK for local/dev only.
#    Operator checklist: docs/operations/P0_OPS_ACTIVATION_CHECKLIST.md
SCANNER_PROVIDER=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# === S3 / Object Storage (optional — falls back to local filesystem) ===
# STORAGE_PROVIDER=s3 enables S3-compatible object storage for evidence files.
# Requires @aws-sdk/client-s3 to be installed.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_BUCKET=aqliya-audit
S3_REGION=eu-west-1
# Optional: S3-compatible endpoint (MinIO, DigitalOcean Spaces, etc.)
# S3_ENDPOINT=https://ams3.digitaloceanspaces.com

# === Redis (optional — falls back to in-memory) ===
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD — required when Redis is configured with --requirepass
# REDIS_PASSWORD=changeme

# === Cache Prefix (for cache key namespacing) ===
# Used to isolate cache keys between environments when sharing a Redis instance.
# Default: "aqliya:cache:"
CACHE_PREFIX=aqliya:cache:

# ─────────────────────────────────────────────
#  Rate Limiter (memory | redis)
# ─────────────────────────────────────────────
#
# 🚨 PRODUCTION: Set RATE_LIMITER=redis in ALL multi-instance deployments
#    (ECS Fargate, Kubernetes, or any deployment with >1 task).
#    Operator checklist: docs/operations/P0_OPS_ACTIVATION_CHECKLIST.md
#
# memory = per-process counter — limits are NOT shared across tasks.
#          Unsafe at scale. Workers operate on independent counters.
#          OK for single-instance dev, CI, or staging with 1 task.
#
# redis  = shared counter across ALL tasks via Redis Lua script.
#          Requires REDIS_URL to be configured.
#          Required for production ECS Fargate with ecs_desired_count >= 2.
#
# Environment check: enterprise-health.ts emits RATE_LIMITER_MEMORY alert
# when running memory mode in multi-instance configurations.
# P0 gate: L6 / unrestricted production claims remain frozen until redis is verified live.
RATE_LIMITER=memory

# === Audit Event Archival (optional) ===
# AuditEvents older than AUDIT_RETENTION_DAYS are archived to NDJSON files
# and removed from the primary table. Run via:
#   node scripts/platform/audit-archival-cron.mjs
# Or schedule with systemd timer / cron / Task Scheduler.
AUDIT_RETENTION_DAYS=365
AUDIT_ARCHIVE_DIR=./audit-archives

# === Performance ===
ANALYZE=false
# === Observability / Tracing ===
# ENABLE_TRACING=true enables lightweight request tracing.
# Future: when OpenTelemetry is integrated, this controls trace export.
ENABLE_TRACING=false

# === Logging ===
LOG_LEVEL=debug

# ===== OAuth (L0-05 partial — invite-only, optional) =====
# User must already exist in DB (seed/signup). Does not auto-provision.
# SAML/LDAP/SCIM enterprise packages are not implemented.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_AZURE_AD_ID=
# AUTH_AZURE_AD_TENANT_ID=
# AUTH_AZURE_AD_SECRET=
# AUTH_OKTA_ID=
# AUTH_OKTA_SECRET=
# AUTH_OKTA_ISSUER=
# SCIM_API_KEY=           # Bearer token for /api/scim/v2/*
# SCIM_DEFAULT_ORG_ID=    # Target org for SCIM provisioning (required when SCIM enabled)

# === Notification Engine ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aqliya.ai
SMTP_SECURE=false
NOTIFICATION_RATE_LIMIT_PER_MIN=60

# ===== FUTURE: CRM Connection Secrets (S7-03 — roadmap, not yet implemented) =====
# Per-connection secrets stored in vault. CRM sync is types+interface only.
# # CRM_CONNECTION__<id>__ACCESS_TOKEN=

# ===== FUTURE: ERP Integration Secrets (LC-08 — roadmap, not yet implemented) =====
# Per-connection secrets stored in vault. ERP integration is types+interface only.
# # ERP_CONNECTION__<id>__API_KEY=

# === Intelligence Core — Tier 2 feature flags (off by default) ===
# FF_ABAC_SHADOW=false          # disable ABAC shadow logging (default: on)
# FF_ABAC_ENFORCE=true          # block access when ABAC denies (pilot orgs only)
# ABAC_ENFORCE_ORG_IDS=          # comma-separated org IDs for enforce pilot
# FF_EVENT_OUTBOX=true          # transactional outbox on platform audit writes
# FF_EVENT_SCHEMA_REGISTRY=true # validate event envelopes at outbox insert/dispatch
# FF_AUDIT_ISA_RULES=true       # ISA rules runtime after FS rebuild
# === LocalContentOS (LCOS) — Specific Configuration (L5 Pilot-ready) ===
# Content Studio persistence backend (required for LCOS Content Studio path)
# prisma = production-like Prisma guard (recommended for pilot).
# file  = file-backed interim store (test only, forbidden on institutional pilot).
LOCALCONTENT_CONTENT_BACKEND=prisma

# LCOS AI feature flags — enable for AI pattern suggestions and grounded context
# FF_AI_REAL_PROVIDERS=true     # Enable real AI providers for LCOS (requires API keys above)
# FF_AI_RAG=true                # Enable RAG context injection for LCOS grounded AI

# LCOS Pilot database (dedicated DB for LCOS pilot — avoids shared dev DB drift)
# DATABASE_URL=postgresql://aqliya_lc_pilot_app:<PASSWORD>@localhost:5432/aqliya_lc_pilot

# LCOS Pilot app URL (separate port from main dev instance)
# NEXTAUTH_URL=http://localhost:3001
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# LCOS — ERP Integration (LC-08 — رد الطريق، لم يتم التنفيذ بعد / roadmap, NOT yet implemented)
# Per-connection secrets stored in vault. ERP connector is types+interface only.
# ERP_CONNECTION__<id>__API_KEY=     # Future — not active

# LCOS — Evidence Storage
# STORAGE_PROVIDER=local             # local | s3 — evidence file storage backend
# LOCAL_STORAGE_DIR=./uploads        # Local storage path (when STORAGE_PROVIDER=local)
# For S3, also configure:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=aqliya-localcontent-evidence
# S3_REGION=me-central-1

# LCOS — Classification Rules Engine
# Classification rules are stored in the database (LcClassificationRule model).
# No additional env vars required for database-backed rules.

# LCOS — AI Provider Notes (reuses platform AI config above)
# The LCOS AI pipeline (pattern suggestions, confidence calibration, false positive review)
# uses the same AI_PROVIDER, API keys, and feature flags as the platform.
# Set FF_AI_REAL_PROVIDERS=true and configure OPENAI_API_KEY or ANTHROPIC_API_KEY above.





